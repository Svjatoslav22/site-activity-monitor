# Copy this file to .env and set real values locally
# GEMINI_API_KEY: Google Generative Language API key (server-side only)
# DO NOT commit real keys to the repository. Copy this file to `.env` and set the real value there.
GEMINI_API_KEY=

# MongoDB connection (example)
MONGO_URI=mongodb://localhost:27017/site-monitor

# JWT secret
JWT_SECRET=change_me_to_a_secure_random_value
